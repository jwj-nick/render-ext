{
  "manifest_version": 3,
  "name": "Raw File Viewer v0.6.0",
  "version": "0.6.0",
  "description": "Read-only viewer for raw files: Markdown (mermaid/wavedrom), Verilog/SystemVerilog, JSON/YAML, C/C++ and more.",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["file:///*", "http://*/*", "https://*/*"],
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": ["file:///*", "http://*/*", "https://*/*"],
      "js": ["common/registry.js", "content/detect.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "options/options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "web_accessible_resources": [
    {
      "resources": ["libs/hwpx/*.js"],
      "matches": ["file:///*", "http://*/*", "https://*/*"]
    }
  ]
}

{ signal: [
  { name: "clk",    wave: "p........." },
  { name: "req",    wave: "0.1...0..." },
  { name: "ack",    wave: "0..1..0..." },
  { name: "addr",   wave: "x.=...x...", data: ["0x40"] },
  { name: "data",   wave: "x...=.x...", data: ["0xDEAD"] },
  {},
  { name: "state",  wave: "=.=.=.=...", data: ["IDLE","REQ","ACK","IDLE"] }
],
  head: { text: "AXI-lite read handshake" },
  config: { hscale: 1 }
}
